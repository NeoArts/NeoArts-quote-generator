{
  "name": "neoarts-quote-generator",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --mode cloud",
    "dev:browser": "vite",
    "dev:local-db": "vite --mode supabase-local",
    "build": "tsc --noEmit && vite build --mode cloud",
    "build:browser": "tsc --noEmit && vite build",
    "build:local-db": "tsc --noEmit && vite build --mode supabase-local",
    "preview": "vite preview",
    "test": "vitest run",
    "e2e": "node e2e/run.mjs",
    "e2e:cloud": "node e2e/cloud.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "file-saver": "2.0.5",
    "jspdf": "2.5.1",
    "jspdf-autotable": "3.8.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hot-toast": "2.6.0",
    "xlsx": "0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/forms": "0.5.10",
    "@types/file-saver": "^2.0.7",
    "@types/react": "^18.3.4",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^25.0.1",
    "playwright-core": "1.48.2",
    "postcss": "^8.4.49",
    "tailwindcss": "3.4.10",
    "typescript": "5.5.4",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
